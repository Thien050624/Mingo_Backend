DB_URL=jdbc:postgresql://localhost:5432/mingo
DB_USERNAME=mingo
DB_PASSWORD=mingo

JWT_SECRET=change-this-to-a-long-random-secret-in-production-min-32-bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional — only needed in production. Leave all unset to keep using local disk storage
# (fine for docker-compose dev, but files are lost on redeploy on most free-tier hosts).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=mingo-uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://<your-public-bucket-domain>
